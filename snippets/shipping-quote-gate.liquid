{% comment %}
  Renders the shipping-destination logic for the TANKEN standing desk.
  Country is read ONLY from the site's own localization/currency selector
  (localization.country) — this widget never offers its own country picker
  and never writes back to site localization. Country context is stated
  explicitly wherever it affects what's shown.

  Accepts:
  - product: {Object} product object.
  - block: {Object} the buy_buttons block (used for the real purchase panel).
  - product_form_id: {String} product form id (used for the real purchase panel).

  Usage:
  {% render 'shipping-quote-gate', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wood_option = product.options_with_values | where: 'name', 'Wood Species' | first
  assign leather_option = product.options_with_values | where: 'name', 'Leather Cover' | first

  assign active_country = localization.country.name
  assign is_us = false
  if localization.country.iso_code == 'US'
    assign is_us = true
  endif

  assign available_country_names = localization.available_countries | map: 'name'
  assign country_supported = false
  if available_country_names contains active_country
    assign country_supported = true
  endif
-%}

<style>
  .shipping-quote-gate__locked-field {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
  }

  .shipping-quote-gate__locked-label {
    color: rgba(var(--color-foreground), 0.7);
  }

  .shipping-quote-gate__locked-value {
    font-weight: 600;
  }

  .shipping-quote-gate__back {
    display: block;
    margin-top: 1.5rem;
  }

  .shipping-quote-gate .form-status {
    margin: 1.5rem 0 2rem;
  }

  .shipping-quote-gate__sent {
    display: inline-block;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-weight: 600;
    letter-spacing: 0.05rem;
    padding: 1rem 2rem;
    border-radius: var(--inputs-radius);
    margin: 1.5rem 0 2rem;
  }

  .shipping-quote-gate__price-lines p {
    margin: 0 0 0.5rem;
  }

  /* This widget's field labels sit outside the input (not Dawn's
     floating-label pattern), so inputs don't need room to make way for one —
     keep padding symmetric instead of the shifted padding .field__input
     normally applies once text is typed. */
  .shipping-quote-gate .field__input,
  .shipping-quote-gate .field__input:focus,
  .shipping-quote-gate .field__input:not(:placeholder-shown) {
    padding: 1.5rem;
  }
</style>

{%- if is_us -%}
  <shipping-quote-gate
    class="shipping-quote-gate"
    data-wood-species="{{ wood_option.selected_value | escape }}"
  >
    <div class="shipping-quote-gate__panel" data-panel="gate">
      <div class="product-form__input">
        <label class="form__label">ZIP code</label>
        <div class="field">
          <input
            class="field__input"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{5}"
            maxlength="5"
            placeholder="ZIP code"
            data-zip-input
          >
        </div>
      </div>

      <button type="button" class="product-form__submit button button--full-width" disabled data-shipping-quote-submit>
        Continue
      </button>
    </div>

    <div class="shipping-quote-gate__panel" data-panel="habachy" hidden>
      <div class="shipping-quote-gate__locked-field">
        <span class="shipping-quote-gate__locked-label">ZIP code</span>
        <span class="shipping-quote-gate__locked-value" data-habachy-zip-display>&mdash;</span>
      </div>

      {%- form 'contact', id: 'HabachyForm', class: 'isolate' -%}
        <div data-habachy-sent{% unless form.posted_successfully? %} hidden{% endunless %}>
          <p class="shipping-quote-gate__sent">Thank you. Habachy Designs will be reaching out to you at <span data-habachy-sent-email>{{ form.email }}</span> shortly.</p>
        </div>
        <div data-habachy-form-content{% if form.posted_successfully? %} hidden{% endif %}>
          <p>We are represented by Habachy Designs in your region. For further assistance, please provide your email and Habachy will be reaching out to you with details shortly.</p>
          {%- if form.errors -%}
            <p class="form-status form__message" role="alert">{{ 'templates.contact.form.error_heading' | t }}</p>
            <ul class="form-status-list caption-large" role="list">
              {%- for field in form.errors -%}
                <li>
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="product-form__input">
            <label class="form__label">{{ 'templates.contact.form.name' | t }} (optional)</label>
            <div class="field">
              <input
                class="field__input"
                type="text"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                autocomplete="name"
                placeholder="{{ 'templates.contact.form.name' | t }}"
              >
            </div>
          </div>
          <div class="product-form__input">
            <label class="form__label">{{ 'templates.contact.form.email' | t }}</label>
            <div class="field">
              <input
                class="field__input"
                type="email"
                name="contact[email]"
                autocomplete="email"
                placeholder="{{ 'templates.contact.form.email' | t }}"
                required
              >
            </div>
          </div>
          <button type="submit" class="button">Request a Quote</button>
        </div>
        <input type="hidden" name="contact[Context]" value="Habachy exclusive region">
        <input type="hidden" name="contact[Country]" value="{{ active_country }}">
        <input type="hidden" name="contact[Zip Code]" data-habachy-zip>
        {%- if wood_option -%}
          <input type="hidden" name="contact[Wood Species]" value="{{ wood_option.selected_value }}">
        {%- endif -%}
        {%- comment -%}
          Height is a cart line-item property (properties[Height]), not a
          real product option, so there's no server-side selected_value to
          read here — JS fills this in from the Height selector at submit
          time instead.
        {%- endcomment -%}
        <input type="hidden" name="contact[Height]" data-tanken-height>
        {%- if leather_option -%}
          <input type="hidden" name="contact[Leather Cover]" value="{{ leather_option.selected_value }}">
        {%- endif -%}
        <button type="button" class="shipping-quote-gate__back link underlined-link" data-shipping-quote-back>
          &larr; Back
        </button>
        {%- if form.posted_successfully? or form.errors -%}
          {%- comment -%}
            form.posted_successfully?/form.errors are only reliable here,
            inside the form block — reveal the panel directly and
            synchronously from here rather than having JS try to re-detect
            "was this just submitted" later by inspecting rendered content.
          {%- endcomment -%}
          <script>
            (function () {
              var panel = document.currentScript.closest('[data-panel="habachy"]');
              var gate = panel && panel.parentElement;
              if (!gate) return;
              gate.querySelectorAll('[data-panel]').forEach(function (p) {
                p.hidden = p !== panel;
              });
            })();
          </script>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="shipping-quote-gate__panel" data-panel="purchase" hidden>
      <div class="shipping-quote-gate__locked-field">
        <span class="shipping-quote-gate__locked-label">ZIP code</span>
        <span class="shipping-quote-gate__locked-value" data-us-zip-display>&mdash;</span>
      </div>

      {%- comment -%}
        US price for the non-exclusive purchase path — Shopify Markets
        already returns the correct US-market price here via render 'price',
        identical to what Add to Cart will actually charge. Wrapped in the
        same id="price-{{ section.id }}" pattern the stock product-info.js
        variant-change handler looks for (see updateSourceFromDestination in
        assets/product-info.js) — without it, this price is invisible to
        that refresh mechanism and never updates when the shopper changes
        Wood Species. Safe to reuse here since the top-of-page price block
        renders nothing at all for Tanken+US (hide_tanken_price), so there's
        no id collision.
      {%- endcomment -%}
      <div id="price-{{ section.id }}" role="status">
        {%- render 'price',
          product: product,
          use_variant: true,
          show_badges: true,
          price_class: 'price--large'
        -%}
      </div>

      {%- render 'buy-buttons',
        block: block,
        product: product,
        product_form_id: product_form_id,
        section_id: section.id,
        show_pickup_availability: true
      -%}
      <button type="button" class="shipping-quote-gate__back link underlined-link" data-shipping-quote-back>
        &larr; Back
      </button>
    </div>
  </shipping-quote-gate>

  <script src="{{ 'habachy-exclusive-zipcodes.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'shipping-quote-gate.js' | asset_url }}" defer="defer"></script>

{%- elsif country_supported -%}
  <div class="shipping-quote-gate">
    {%- render 'buy-buttons',
      block: block,
      product: product,
      product_form_id: product_form_id,
      section_id: section.id,
      show_pickup_availability: true
    -%}
  </div>

{%- else -%}
  <div class="shipping-quote-gate">
    <p>
      <strong>We haven't calculated shipping for {{ active_country }} yet.</strong> Please provide your email so that we can send you the pricing directly.
    </p>

    {%- form 'contact', id: 'NoShippingForm', class: 'isolate' -%}
      {%- if form.posted_successfully? -%}
        <p class="shipping-quote-gate__sent">Sent</p>
      {%- elsif form.errors -%}
        <p class="form-status form__message" role="alert">{{ 'templates.contact.form.error_heading' | t }}</p>
        <ul class="form-status-list caption-large" role="list">
          {%- for field in form.errors -%}
            <li>
              {{ form.errors.translated_fields[field] | capitalize }}
              {{ form.errors.messages[field] }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <input type="hidden" name="contact[Context]" value="Missing shipping information">
      <input type="hidden" name="contact[Country]" value="{{ active_country }}">
      {%- if wood_option -%}
        <input type="hidden" name="contact[Wood Species]" value="{{ wood_option.selected_value }}">
      {%- endif -%}
      {%- comment -%}
        Height is a cart line-item property (properties[Height]), not a real
        product option, so there's no server-side selected_value to read
        here — JS fills this in from the Height selector at submit time
        instead.
      {%- endcomment -%}
      <input type="hidden" name="contact[Height]" data-tanken-height>
      {%- if leather_option -%}
        <input type="hidden" name="contact[Leather Cover]" value="{{ leather_option.selected_value }}">
      {%- endif -%}
      {%- unless form.posted_successfully? -%}
        <div class="product-form__input">
          <label class="form__label">{{ 'templates.contact.form.name' | t }} (optional)</label>
          <div class="field">
            <input
              class="field__input"
              type="text"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              autocomplete="name"
              placeholder="{{ 'templates.contact.form.name' | t }}"
            >
          </div>
        </div>
        <div class="product-form__input">
          <label class="form__label">{{ 'templates.contact.form.email' | t }}</label>
          <div class="field">
            <input
              class="field__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              placeholder="{{ 'templates.contact.form.email' | t }}"
              required
            >
          </div>
        </div>
        <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
      {%- endunless -%}
    {%- endform -%}
  </div>
{%- endif -%}
