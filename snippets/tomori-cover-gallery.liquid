{% comment %}
  Replaces the standard product media gallery for TOMORI with a one-at-a-time
  image viewer (prev/next buttons only, no scroll/swipe — via the shared
  <simple-image-gallery> component) that combines:
  - 2 dynamic slides (lamp off / lamp on) driven by the custom.cover_gallery
    product metafield — JSON keyed by Wood species then Sasawashi Color, each
    value an [off_url, on_url] pair.
  - the product's general/common photos (anything not named after a specific
    wood+color combo), shown exactly like a normal Shopify gallery.

  Sasawashi Color is a cart line-item property (see
  tomori-cover-property.liquid), not a real variant, so there's no native
  Shopify variant-image mechanism to hook into — tomori-cover-gallery.js
  swaps the 2 dynamic slides' images client-side instead, keyed off the real
  Wood species variant-change event plus the Color radio's own change event,
  then asks <simple-image-gallery> to jump back to slide 0 so the change is
  immediately visible.

  Accepts:
  - product: {Object} product object.
  - section_id: {String} unique id scope, matches the section rendering this
    (needed to filter PUB_SUB_EVENTS.variantChange to the right section).

  Usage:
  {% render 'tomori-cover-gallery', product: product, section_id: section.id %}
{% endcomment %}
{{ 'component-simple-image-gallery.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign wood_option = product.options_with_values | where: 'name', 'Wood species' | first
  assign gallery_data = product.metafields.custom.cover_gallery.value
  assign default_color = 'Black'
  assign off_src = blank
  assign on_src = blank
  if gallery_data
    assign wood_data = gallery_data[wood_option.selected_value]
    if wood_data
      assign default_pair = wood_data[default_color]
      if default_pair
        assign off_src = default_pair[0]
        assign on_src = default_pair[1]
      endif
    endif
  endif
  unless off_src
    assign off_src = product.featured_image | image_url: width: 1500
  endunless
  unless on_src
    assign on_src = product.featured_image | image_url: width: 1500
  endunless

  assign common_media = product.media | where: 'media_type', 'image'
  assign slide_count = 2
  for media in common_media
    unless media.src contains '_off.jpg' or media.src contains '_on.jpg'
      assign slide_count = slide_count | plus: 1
    endunless
  endfor
-%}
<simple-image-gallery data-tomori-cover-gallery data-section-id="{{ section_id }}">
  <div class="simple-image-gallery__viewer">
    <div class="simple-image-gallery__slide is-active" data-gallery-slide>
      <img
        class="simple-image-gallery__image"
        data-tomori-cover-image="off"
        src="{{ off_src }}"
        alt="{{ product.title | escape }} — lamp off"
        width="1500"
        height="1500"
      >
    </div>
    <div class="simple-image-gallery__slide" data-gallery-slide>
      <img
        class="simple-image-gallery__image"
        data-tomori-cover-image="on"
        src="{{ on_src }}"
        alt="{{ product.title | escape }} — lamp on"
        width="1500"
        height="1500"
      >
    </div>
    {%- for media in common_media -%}
      {%- unless media.src contains '_off.jpg' or media.src contains '_on.jpg' -%}
        <div class="simple-image-gallery__slide" data-gallery-slide>
          <img
            class="simple-image-gallery__image"
            src="{{ media | image_url: width: 1500 }}"
            alt="{{ media.alt | escape }}"
            width="1500"
            height="{{ 1500 | divided_by: media.aspect_ratio }}"
            loading="lazy"
          >
        </div>
      {%- endunless -%}
    {%- endfor -%}
  </div>
  <div class="simple-image-gallery__controls">
    <button type="button" name="previous" data-gallery-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
    </button>
    <div class="slider-counter caption">
      <span data-gallery-current>1</span>
      <span aria-hidden="true"> / </span>
      <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
      <span>{{ slide_count }}</span>
    </div>
    <button type="button" name="next" data-gallery-next aria-label="{{ 'general.slider.next_slide' | t }}">
      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
    </button>
  </div>
  <script type="application/json" data-tomori-cover-gallery-data>
    {{ gallery_data | json }}
  </script>
</simple-image-gallery>
<script src="{{ 'simple-image-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'tomori-cover-gallery.js' | asset_url }}" defer="defer"></script>
