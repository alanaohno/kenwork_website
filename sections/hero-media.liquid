{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  #Hero-{{ section.id }} {
    --hero-height: {{ section.settings.height_mobile }}svh;
    --hero-focal: {{ section.settings.focal_x_mobile }}% {{ section.settings.focal_y_mobile }}%;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  @media screen and (min-width: 750px) {
    #Hero-{{ section.id }} {
      --hero-height: {{ section.settings.height_desktop }}svh;
      --hero-focal: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%;
    }
  }
{%- endstyle -%}

<section id="Hero-{{ section.id }}" class="hero-media">
  <div class="hero-media__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          class: 'hero-media__image',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: section.settings.image.alt,
          fetchpriority: fetch_priority
      }}
    {%- elsif section.settings.video == blank -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-media__image placeholder-svg' }}
    {%- endif -%}

    {%- comment -%}
      Video (when set) plays over the image. The image stays underneath as the
      poster / fallback while the video loads or if autoplay is blocked. With a
      video and no image, nothing is rendered underneath: the video element's
      own poster / first frame shows on the black background.
    {%- endcomment -%}
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          class: 'hero-media__video',
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'auto',
          image_size: '2000x'
      }}
    {%- endif -%}
  </div>

  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="hero-media__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-media__heading">{{ section.settings.heading | escape | replace: '|', ' <br class="hero-media__break">' }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero-media__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .hero-media {
    position: relative;
    width: 100%;
    height: var(--hero-height);
    min-height: 26rem;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: #000;
    color: #fff;
  }

  .hero-media__media {
    position: absolute;
    inset: 0;
  }

  .hero-media__media::after {
    /* darkens the bottom edge so the white text stays legible on any photo */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, calc(var(--hero-overlay) * 3)) 0%, rgba(0, 0, 0, var(--hero-overlay)) 45%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }

  .hero-media__image,
  .hero-media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* !important: Shopify adds an inline object-position from the image's saved focal point in Files */
    object-position: var(--hero-focal) !important;
  }

  .hero-media__content {
    position: relative;
    z-index: 1;
    width: 100%;
    box-sizing: border-box;
    padding: 0 2rem 2.4rem;
    text-align: left;
  }

  /* Font sizes are tied to viewport width so the text scales with the image
     and never overflows on small screens. */
  .hero-media__heading {
    margin: 0;
    max-width: 100%;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 11vw;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .hero-media__subheading {
    margin: 1.2rem 0 0;
    max-width: 100%;
    /* same font as the Japanese headings elsewhere on the page */
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: 4.6vw;
    line-height: 1.3;
    color: #fff;
    overflow-wrap: break-word;
  }

  @media screen and (min-width: 750px) {
    .hero-media__content {
      padding: 0 5rem 4.8rem;
    }

    .hero-media__heading {
      /* three lines; the longest ("Office Furniture") spans about 28% of the video */
      font-size: 4.8vw;
    }

    .hero-media__subheading {
      margin-top: 1.8rem;
      /* 14 full-width characters = 14em, so 2vw matches the width of "Office Furniture" at 4.8vw */
      font-size: 2vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media__video {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* iOS Safari can leave an autoplay video paused (Low Power Mode, or if the
     `muted` attribute isn't applied before playback is attempted). Set muted as a
     property, call play() ourselves, and retry on the first touch as a last resort. */
  (() => {
    const start = (video) => {
      video.muted = true;
      video.defaultMuted = true;
      video.setAttribute('playsinline', '');
      const attempt = () => video.paused && video.play().catch(() => {});
      attempt();
      // Private browsing tabs can defer or refuse the first play(); retry on every signal
      // that the video is ready, was paused by the browser, or the page came back.
      ['loadeddata', 'canplay', 'suspend', 'pause', 'stalled'].forEach((type) => video.addEventListener(type, attempt));
      window.addEventListener('pageshow', attempt);
      document.addEventListener('visibilitychange', () => !document.hidden && attempt());
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => entries.some((e) => e.isIntersecting) && attempt()).observe(video);
      }
      // Fall back to user input until it actually plays. Scroll and touch events are included
      // because the video starts on scroll in iOS private tabs; touchend/click are real gestures.
      const gestureEvents = ['touchstart', 'touchend', 'click', 'scroll'];
      const onGesture = () => (video.paused ? attempt() : removeGestureListeners());
      const removeGestureListeners = () =>
        gestureEvents.forEach((type) => window.removeEventListener(type, onGesture));
      gestureEvents.forEach((type) => window.addEventListener(type, onGesture, { passive: true }));
      video.addEventListener('playing', removeGestureListeners, { once: true });
    };

    document.querySelectorAll('.hero-media__video').forEach(start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Hero media",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown on its own, or as the poster underneath the video."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Optional. Upload a Shopify-hosted video to replace the image. It autoplays muted and loops, so use a short, compressed clip."
    },
    {
      "type": "range",
      "id": "focal_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "Focal point: horizontal (desktop)",
      "info": "Which part of the media stays in view when it is cropped (0 = left, 100 = right)."
    },
    {
      "type": "range",
      "id": "focal_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "Focal point: vertical (desktop)",
      "info": "0 = top, 100 = bottom."
    },
    {
      "type": "range",
      "id": "focal_x_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "Focal point: horizontal (mobile)",
      "info": "Phones crop the sides much harder. Set this to the horizontal position of the subject."
    },
    {
      "type": "range",
      "id": "focal_y_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "Focal point: vertical (mobile)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "%",
      "default": 10,
      "label": "Bottom shading",
      "info": "Darkens the bottom of the media so the white text is readable."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Use | to mark line breaks.",
      "default": "Office Furniture|for your|Living Room"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "リビングに置けるオフィス家具"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "label": "Height on desktop",
      "info": "Percent of the browser window height."
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85,
      "label": "Height on mobile"
    }
  ],
  "presets": [
    {
      "name": "Hero media"
    }
  ]
}
{% endschema %}
